{
    "name": "rushing/laravel-versioning",
    "description": "A record-agnostic linear versioning seam for Laravel: the Versionable contract+trait (immutable named snapshot + HEAD pin + restore), an immutable Version model, and a VersionStore. Any schema-driven record opts in; the app owns the tenant migration.",
    "keywords": ["laravel", "versioning", "snapshot", "history", "restore", "seam", "immutable"],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Versioning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Versioning\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\Versioning\\VersioningServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    }
}
